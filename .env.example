# Copy to .env for local Docker Compose use. Keep .env out of Git.
DB_ADMIN_PASSWORD=replace-with-a-long-random-postgres-superuser-password
DB_PASSWORD=replace-with-a-long-random-runtime-app-password
DB_MIGRATION_PASSWORD=replace-with-a-long-random-schema-migration-password
TRUSTVAULT_AUDIT_HMAC_KEY=replace-with-at-least-32-random-characters
TRUSTVAULT_FILE_ENCRYPTION_KEY=replace-with-base64-encoding-of-32-random-bytes
TRUSTVAULT_BOOTSTRAP_ADMIN_EMAIL=security-admin@your-company.example
TRUSTVAULT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-16-plus-character-secret

# Set true when the app is served through HTTPS; false is for local HTTP testing.
TRUSTVAULT_COOKIE_SECURE=false
